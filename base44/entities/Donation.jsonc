{
  "name": "Donation",
  "type": "object",
  "properties": {
    "donor_name": {
      "type": "string"
    },
    "donor_email": {
      "type": "string"
    },
    "donor_phone": {
      "type": "string"
    },
    "donor_type": {
      "type": "string",
      "enum": [
        "Individual",
        "Corporate",
        "Foundation",
        "Government",
        "Anonymous"
      ],
      "default": "Individual"
    },
    "amount": {
      "type": "number"
    },
    "donation_type": {
      "type": "string",
      "enum": [
        "One-Time",
        "Recurring",
        "Sponsorship",
        "In-Kind",
        "Event"
      ],
      "default": "One-Time"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Credit Card",
        "Debit Card",
        "Interac",
        "EFT",
        "Cheque",
        "Cash",
        "Other"
      ]
    },
    "designation": {
      "type": "string",
      "enum": [
        "General Fund",
        "Youth Programs",
        "Cultural Programs",
        "Housing",
        "Mental Health",
        "Education",
        "Emergency Fund",
        "Other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Completed",
        "Pending",
        "Failed",
        "Refunded"
      ],
      "default": "Completed"
    },
    "receipt_issued": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "donor_name",
    "amount"
  ]
}