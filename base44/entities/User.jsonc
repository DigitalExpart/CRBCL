{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "team": {
      "type": "string",
      "description": "The team the user is assigned to",
      "enum": [
        "Executive Leadership",
        "Child & Family Services",
        "Prevention & Healing",
        "Sacred Wolf Lodge",
        "Home Fire",
        "Family Support Liaison",
        "Cultural & Traditional Healing",
        "Youth & Children Programs",
        "Clinical & Wellness",
        "Intake & Assessment",
        "Quality Assurance & Practice",
        "Legal & Jurisdiction",
        "Human Resources",
        "Finance & Administration",
        "IT & Innovation",
        "Communications & Community",
        "Training & Professional Dev.",
        "Research, Data & Reporting",
        "Navigation Team",
        "Growing Up Well",
        "Culture Team",
        "Post Majority",
        "Unassigned"
      ],
      "default": "Unassigned"
    },
    "team_access": {
      "type": "array",
      "description": "List of team IDs the user has dashboard access to. Use [\"all\"] for access to all teams.",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "role"
  ]
}