{
  "name": "FundingGrant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "funder": {
      "type": "string"
    },
    "grant_type": {
      "type": "string",
      "enum": [
        "Federal",
        "Provincial",
        "Municipal",
        "Foundation",
        "Corporate",
        "Other"
      ]
    },
    "amount": {
      "type": "number"
    },
    "amount_spent": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Applied",
        "Approved",
        "Pending Review",
        "Completed",
        "Rejected",
        "Expired"
      ],
      "default": "Applied"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "reporting_deadline": {
      "type": "string",
      "format": "date"
    },
    "program_area": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "deliverables": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "funder",
    "amount"
  ]
}