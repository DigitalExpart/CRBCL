{
  "name": "Employee",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "enum": [
        "Administration",
        "Case Management",
        "Youth Services",
        "Family Services",
        "Mental Health",
        "Cultural Programs",
        "Housing",
        "Finance",
        "HR",
        "IT",
        "Community Outreach"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "On Leave",
        "Terminated",
        "Probation"
      ],
      "default": "Active"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "supervisor_name": {
      "type": "string"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "caseload_count": {
      "type": "number",
      "default": 0
    },
    "photo_url": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "position"
  ]
}