{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Case File",
        "Policy",
        "Report",
        "Form",
        "Legal",
        "Financial",
        "HR",
        "Training",
        "General"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "file_type": {
      "type": "string"
    },
    "file_size": {
      "type": "string"
    },
    "related_case_id": {
      "type": "string"
    },
    "related_client_id": {
      "type": "string"
    },
    "uploaded_by_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_confidential": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "file_url"
  ]
}