{
  "name": "Program",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Youth Services",
        "Family Support",
        "Cultural Programming",
        "Mental Health",
        "Housing",
        "Education",
        "Employment",
        "Community",
        "Prevention",
        "Crisis"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive",
        "Planning",
        "Completed"
      ],
      "default": "Active"
    },
    "description": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "capacity": {
      "type": "number"
    },
    "enrolled_count": {
      "type": "number",
      "default": 0
    },
    "location": {
      "type": "string"
    },
    "coordinator_name": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "funding_source": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ]
}