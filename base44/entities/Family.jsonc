{
  "name": "Family",
  "type": "object",
  "properties": {
    "family_name": {
      "type": "string"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_phone": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "province": {
      "type": "string",
      "default": "Saskatchewan"
    },
    "postal_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive",
        "Under Review",
        "Closed"
      ],
      "default": "Active"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "default": "Low"
    },
    "total_members": {
      "type": "number",
      "default": 1
    },
    "indigenous_identity": {
      "type": "string",
      "enum": [
        "First Nations",
        "M\u00e9tis",
        "Inuit",
        "Non-Indigenous",
        "Mixed"
      ]
    },
    "band_nation": {
      "type": "string"
    },
    "assigned_worker_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "services_enrolled": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "family_name"
  ]
}