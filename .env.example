# ============================================================
# CRBCL Platform — Environment Configuration
# ============================================================
# Copy this file to .env (root) and backend/.env
# NEVER commit actual secrets to source control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=CRBCL Platform
APP_DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://crbcl:crbcl_dev_password@localhost:5432/crbcl
DATABASE_SYNC_URL=postgresql://crbcl:crbcl_dev_password@localhost:5432/crbcl

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Session / Auth ---
SESSION_SECRET=CHANGE-ME-generate-a-64-char-random-string
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Object Storage ---
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=crbcl-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Demo Mode ---
DEMO_MODE=false

# --- Vite Frontend Environment ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ID=crbcl-portal
VITE_ENABLE_DEMO_DATA=false
