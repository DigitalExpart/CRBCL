# ============================================================
# CRBCL Backend — Environment Configuration Template
# ============================================================
# Copy this file to backend/.env
# NEVER commit actual passwords or keys to source control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=CRBCL Platform
APP_DEBUG=true

# --- Database (Supabase PostgreSQL / PostGIS) ---
# Async engine for FastAPI runtime (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require

# Synchronous engine for Alembic migrations and CLI operations (psycopg)
DATABASE_SYNC_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# --- Redis (Distributed Caching & Task Queues) ---
REDIS_URL=redis://localhost:6379/0

# --- Frontend & CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Session & Authentication ---
SESSION_SECRET=CHANGE-ME-generate-a-64-char-random-hex-string
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# --- Object Storage ---
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=crbcl-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Demo Mode ---
DEMO_MODE=false

# --- Email Delivery (OTP & Notifications) ---
# Choose provider: console (logs code to terminal for dev), resend, smtp
EMAIL_PROVIDER=console

# Option A: Resend API (Recommended - Free 3000/mo at resend.com)
RESEND_API_KEY=

# Option B: Standard SMTP / Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@crbcl.ca
SMTP_FROM_NAME=Chief Red Bear Children's Lodge
